# ── 服务 ─────────────────────────────────────────────────
# 运行环境：production / development（影响日志默认级别与 Cookie Secure 默认值）
NODE_ENV=production

# 监听端口
PORT=3000

# 数据存储目录（默认 server/data）；账号、登录态均存于此，请勿对外暴露
# DATA_DIR=/www/wwwroot/wangyiyun/data

# 结构化日志级别：trace / debug / info / warn / error（默认 production=info，其余=debug）
# LOG_LEVEL=info

# ── 安全（对外公开务必设置）─────────────────────────────────
# 用于会话签名 + 登录态加密。强烈建议显式设置一个足够随机的长字符串：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未设置时会自动生成并持久化到数据目录（更换该值会使已有会话与已加密登录态失效）。
# SESSION_SECRET=

# 会话有效期（毫秒），默认 7 天
# SESSION_MAX_AGE_MS=604800000

# 反向代理跳数（宝塔 / Nginx 反代时设为 1；直连可设 0 或 false）
# TRUST_PROXY=1

# 会话 Cookie 是否仅在 HTTPS 下发送。生产默认开启；无 HTTPS 的内网可设 false
# COOKIE_SECURE=true

# ── 注册策略 ────────────────────────────────────────────────
# 是否开放注册（false 可关闭注册，仅允许已有账号登录）
# ALLOW_REGISTRATION=true

# 密码最小长度
# MIN_PASSWORD_LENGTH=8

# 平台账号数量上限（0 = 不限制）
# MAX_ACCOUNTS=0
